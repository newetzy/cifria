---
import CategoryPage from '../../components/CategoryPage.astro';
import Layout from '../../layouts/Layout.astro';
import { categories } from '../../data/categories';
const category = categories.find(({ slug }) => slug === 'coche')!;
---
<Layout title="Calculadoras de costes del coche | Cifria" description="Explora calculadoras de costes del coche para estimar combustible de un viaje y coste por kilómetro. Separa trayecto, gastos anuales, peajes y kilometraje."><CategoryPage category={category} /></Layout>
