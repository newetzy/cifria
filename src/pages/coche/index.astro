---
import CategoryPage from '../../components/CategoryPage.astro';
import Layout from '../../layouts/Layout.astro';
import { categories } from '../../data/categories';
const category = categories.find(({ slug }) => slug === 'coche')!;
---
<Layout title="Calculadoras de costes del coche | Cifria" description="Estima el combustible de un viaje y el coste por kilómetro de tu coche. Distingue los gastos del trayecto de los costes anuales del vehículo."><CategoryPage category={category} /></Layout>
