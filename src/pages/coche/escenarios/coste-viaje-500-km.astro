---
import Layout from '../../layouts/Layout.astro';
import SeoLandingPage from '../../components/SeoLandingPage.astro';
import { calculateFuelTrip } from '../../lib/calculations/fuel-trip.ts';
import { formatEuro, formatNumber } from '../../lib/formatters/currency.ts';
const result = calculateFuelTrip({ distanceKm: 500, consumptionLitersPer100Km: 6.5, fuelPricePerLiter: 1.6, tolls: 0 });
---
<Layout title="Coste de un viaje de 500 km en gasolina | Cifria" description="Consulta un ejemplo de combustible para un viaje de 500 km. Revisa litros, coste por persona y cómo cambia el presupuesto si añades el regreso.">
  <SeoLandingPage
    interpretation={{
      title: "Coste de un viaje de 500 km en gasolina: ejemplo para cuatro personas",
      paragraphs: [
        "Calcular el coste de un viaje de 500 km con un consumo hipotético de 6 litros cada cien kilómetros requiere 30 litros. A un precio supuesto de 1,60 euros por litro, el combustible cuesta 48 euros. Si cuatro personas acuerdan repartirlo por igual, corresponden 12 euros a cada una; esos importes no incluyen peajes ni otros gastos.",
        "Comprueba si los 500 kilómetros describen todo el recorrido o solamente la ida. Volver por una ruta de igual longitud duplicaría la distancia a 1.000 kilómetros y, manteniendo consumo y precio, el combustible a 96 euros. No actives además una opción de ida y vuelta después de introducir ya los kilómetros totales, porque estarías duplicando la distancia dos veces.",
      ],
    }}
    title="Coste de un viaje de 500 km en gasolina" description="Calcula una referencia del combustible necesario y del coste para recorrer 500 km." intro={`Con 500 km de distancia, un consumo supuesto de 6,5 l/100 km y gasolina a 1,60 €/l, el viaje necesita unos ${formatNumber(result.litersNeeded)} litros y cuesta aproximadamente ${formatEuro(result.fuelCost)} en combustible.`} exampleTitle="Supuesto del ejemplo" exampleText={`Distancia: 500 km · consumo: 6,5 l/100 km · precio: 1,60 €/l · combustible: ${formatEuro(result.fuelCost)} · coste por km: ${formatEuro(result.costPerKm)}.`} calculatorHref="/coche/coste-viaje-gasolina/" calculatorLabel="Calcular coste del viaje" sections={[
    { title: 'La distancia no es suficiente', paragraphs: ['Dos coches pueden recorrer los mismos 500 km y gastar importes diferentes porque el consumo y el precio del combustible cambian.', 'Por eso la herramienta usa kilómetros, litros por 100 km y precio por litro.'] },
    { title: 'Añade peajes cuando existan', paragraphs: ['El ejemplo usa 0 € de peajes para aislar el combustible. Si tu ruta tiene peajes, puedes introducirlos y obtener un coste total más cercano a tu viaje.', 'También puedes calcular el coste por kilómetro del trayecto.'] },
    { title: 'Un ejemplo no es un precio actual', paragraphs: ['El precio de 1,60 €/l es únicamente un supuesto estático. Para una previsión real, introduce el precio que estés observando antes del viaje.', 'La herramienta no obtiene precios de gasolineras en tiempo real.'] },
  ]} faqs={[
    { question: '¿Cuántos litros hacen falta para 500 km con 6,5 l/100 km?', answer: `La simulación necesita aproximadamente ${formatNumber(result.litersNeeded)} litros.` },
    { question: '¿Cuánto cuesta el combustible en este ejemplo?', answer: `A 1,60 €/l, el coste estimado es de ${formatEuro(result.fuelCost)}.` },
    { question: '¿Incluye peajes?', answer: 'El ejemplo no incluye ninguno, pero la calculadora permite añadir el importe de los peajes al coste total.' },
  ]} />
</Layout>
