---
import CategoryPage from '../../components/CategoryPage.astro';
import Layout from '../../layouts/Layout.astro';
import { categories } from '../../data/categories';
const category = categories.find(({ slug }) => slug === 'prestamos')!;
---
<Layout title="Calculadoras de préstamos personales | Cifria" description="Explora calculadoras de préstamos personales para simular cuotas fijas y amortizaciones anticipadas. Compara importe, plazo, intereses y coste total."><CategoryPage category={category} /></Layout>
