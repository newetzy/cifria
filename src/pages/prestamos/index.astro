---
import CategoryPage from '../../components/CategoryPage.astro';
import Layout from '../../layouts/Layout.astro';
import { categories } from '../../data/categories';
const category = categories.find(({ slug }) => slug === 'prestamos')!;
---
<Layout title="Calculadoras de préstamos personales | Cifria" description="Simula cuotas de préstamos a tipo fijo y amortizaciones anticipadas. Compara mensualidades, intereses y coste total según el importe y el plazo."><CategoryPage category={category} /></Layout>
