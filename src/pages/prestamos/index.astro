---
import Layout from '../../layouts/Layout.astro';
import Card from '../../components/Card.astro';
---
<Layout title="Calculadoras de préstamos | Calculadoras ES" description="Calculadoras de cuota, TIN, TAE e intereses de préstamos.">
  <div class="container category-page">
    <section class="category-hero"><span class="kicker">Préstamos</span><h1>Antes de firmar, calcula el coste.</h1><p>Cuota mensual, intereses y escenarios para préstamos personales y financiación.</p></section>
    <div class="card-grid">
      <Card title="Cuota de préstamo" description="Calcula la cuota y el coste total de un préstamo." href="#" eyebrow="Próximamente" />
      <Card title="TIN vs TAE" description="Entiende la diferencia y cómo afecta al coste." href="#" eyebrow="Próximamente" />
      <Card title="Amortización de préstamo" description="Comprueba cuánto reduces de intereses al amortizar." href="#" eyebrow="Próximamente" />
    </div>
  </div>
</Layout>
