---
import Layout from '../../layouts/Layout.astro';
import Card from '../../components/Card.astro';
---
<Layout title="Calculadoras de impuestos | Calculadoras ES" description="Calculadoras de IVA, ITP y otras herramientas fiscales para particulares en España.">
  <div class="container category-page">
    <section class="category-hero"><span class="kicker">Impuestos</span><h1>Calcula impuestos con claridad.</h1><p>Herramientas orientativas con metodología y fuentes para entender cómo funcionan los cálculos.</p></section>
    <div class="card-grid">
      <Card title="Calculadora de IVA" description="Añade o quita IVA y calcula base imponible e impuesto." href="#" eyebrow="Próximamente" />
      <Card title="Calculadora ITP" description="Estimación del impuesto de transmisiones patrimoniales." href="#" eyebrow="Próximamente" />
      <Card title="Ganancia patrimonial" description="Calcula la ganancia o pérdida de una venta a partir de tus datos." href="#" eyebrow="Próximamente" />
    </div>
  </div>
</Layout>
