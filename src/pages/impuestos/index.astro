---
import CategoryPage from '../../components/CategoryPage.astro';
import Layout from '../../layouts/Layout.astro';
import { categories } from '../../data/categories';
const category = categories.find(({ slug }) => slug === 'impuestos')!;
---
<Layout title="Calculadoras de impuestos en España | Cifria" description="Herramientas para realizar cálculos tributarios habituales y consultar su metodología y fuentes."><CategoryPage category={category} /></Layout>
