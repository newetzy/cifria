---
import CategoryPage from '../../components/CategoryPage.astro';
import Layout from '../../layouts/Layout.astro';
import { categories } from '../../data/categories';
const category = categories.find(({ slug }) => slug === 'impuestos')!;
---
<Layout title="Calculadoras de impuestos en España | Cifria" description="Calcula IVA añadido o incluido y consulta una estimación simplificada del IRPF 2025. Revisa los datos necesarios, las fuentes y los límites de cada modelo."><CategoryPage category={category} /></Layout>
