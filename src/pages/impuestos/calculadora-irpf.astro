---
import CalculatorShell from '../../components/CalculatorShell.astro'; import Disclaimer from '../../components/Disclaimer.astro'; import Layout from '../../layouts/Layout.astro';
const regions = ['andalucia','aragon','asturias','baleares','canarias','cantabria','castilla-la-mancha','castilla-y-leon','cataluna','extremadura','galicia','madrid','murcia','navarra','pais-vasco','rioja','valencia'];
---
<Layout title="Calculadora de IRPF 2025 | Cifria" description="Estima tu IRPF de 2025 con rentas, retenciones y situación personal y familiar."><section class="calculator-page-section"><CalculatorShell title="Calculadora de IRPF 2025" description="Obtén una estimación orientativa de cuota y resultado de la renta."><div class="calculator-layout"><form id="irpf-form" class="calculator-form" novalidate><fieldset><legend>Datos fiscales</legend><div class="calculator-fields">{[['salary','Salario bruto anual',30000],['otherIncome','Otros ingresos generales',0],['savingsIncome','Rendimientos del ahorro',0],['socialContributions','Cotizaciones a la Seguridad Social',1905],['pensionContributions','Aportaciones a pensiones',0],['withheld','Retenciones ya practicadas',4000],['age','Edad',35],['children','Descendientes',0],['childrenUnder3','Descendientes menores de 3 años',0],['dependantsOver65','Ascendientes mayores de 65 años',0]].map(([id,label,value]) => <div class="field"><label for={String(id)}>{label}</label><input id={String(id)} type="number" min="0" step="1" value={String(value)} /></div>)}<div class="field"><label for="filing">Declaración</label><select id="filing"><option value="individual">Individual</option><option value="joint">Conjunta</option></select></div><div class="field"><label for="disability">Discapacidad</label><select id="disability"><option value="none">No</option><option value="33">33 % o más</option><option value="65">65 % o más</option></select></div><div class="field"><label for="region">Comunidad autónoma</label><select id="region">{regions.map((region) => <option value={region}>{region.replaceAll('-', ' ')}</option>)}</select></div></div></fieldset><button type="submit">Estimar IRPF</button></form><div id="irpf-results" class="calculator-results" hidden><p class="eyebrow">Estimación</p><section class="result-card result-card-primary"><p data-result="balance-label">Resultado estimado</p><strong data-result="balance">—</strong></section><div class="result-grid"><section class="result-card"><p>Cuota estimada</p><strong data-result="tax">—</strong></section><section class="result-card"><p>Base general</p><strong data-result="base">—</strong></section><section class="result-card"><p>Base del ahorro</p><strong data-result="savings">—</strong></section><section class="result-card"><p>Mínimo personal y familiar</p><strong data-result="minimum">—</strong></section></div></div></div><p id="irpf-announcement" class="sr-only" aria-live="polite"></p><Disclaimer>Estimación orientativa para el ejercicio 2025. No incluye deducciones autonómicas ni todos los supuestos fiscales; confirma el resultado con Renta WEB.</Disclaimer></CalculatorShell></section></Layout><script>import '../../scripts/irpf';</script>
