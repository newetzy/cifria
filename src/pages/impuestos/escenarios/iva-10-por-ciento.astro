<Layout title='Calculadora de IVA del 10 % | Cifria' description='Añade o quita un IVA del 10 % y separa base imponible e impuesto.'>
  <SeoLandingPage title='IVA del 10 %' description='Añade o quita un IVA del 10 % y separa base imponible e impuesto.' intro='El 10 % es uno de los tipos de IVA que puedes usar como hipótesis en la calculadora de Cifria.' exampleTitle="Ejemplo de uso" exampleText='Introduce un precio sin IVA para añadir el 10 %, o parte del precio final para separar base e impuesto.' calculatorHref='/impuestos/calculadora-iva/' calculatorLabel='Calcular IVA' sections={[{ title: 'Cómo leer el resultado', paragraphs: ['La herramienta separa el importe base del impuesto para que puedas ver de dónde sale el precio final.'] },
    { title: 'El tipo depende del caso', paragraphs: ['Antes de aplicar un tipo de IVA a una operación real debes comprobar que corresponde al bien o servicio concreto.'] }]} faqs={[{ question: '¿Puedo quitar un 10 % de un precio final restándolo directamente?', answer: 'No. Para quitar IVA debes dividir el precio final por 1,10 y separar la base y el impuesto.' },
    { question: '¿Todo lleva un 10 % de IVA?', answer: 'No. El tipo aplicable depende del producto o servicio y de la normativa vigente.' }]} />
</Layout>
