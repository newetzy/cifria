---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import PostCard from '../../../components/PostCard.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const categories = [...new Set(posts.map((post) => post.data.category))];

  return categories.map((category) => ({
    params: { category },
    props: {
      category,
      posts: posts
        .filter((post) => post.data.category === category)
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

const { category, posts } = Astro.props;
const categoryName = category.replace('-', ' ');
const primaryKeywords: Record<string, string> = {
  vivienda: 'Consejos financieros para vivienda',
  fiscalidad: 'Consejos fiscales para la renta',
};
const primaryKeyword = primaryKeywords[category] ?? `Consejos de ${categoryName}`;
const descriptions: Record<string, string> = {
  vivienda: 'Lee artículos sobre Euríbor, hipotecas y compra frente a alquiler. Revisa las variables de cada decisión y accede a calculadoras de vivienda.',
  fiscalidad: 'Prepara los datos de tu declaración con artículos sobre renta e impuestos. Consulta fuentes oficiales y conoce los límites de las estimaciones fiscales.',
  'finanzas-personales': 'Explora artículos sobre ahorro y decisiones cotidianas de dinero. Relaciona los conceptos con ejemplos y calculadoras para adaptar las cifras a tu caso.',
};
---

<Layout title={`${primaryKeyword} | Cifria`} description={descriptions[category]}>
  <section class="blog-index container">
    <div class="blog-intro">
      <p class="eyebrow">Blog Cifria</p>
      <h1>{primaryKeyword}</h1>
      <p class="lead"><strong>{primaryKeyword}</strong>: artículos y herramientas para preparar decisiones con datos comprobables.</p>
    </div>
    <div class="blog-grid">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
    <section class="prose"><h2>Cómo leer los artículos de {categoryName}</h2><p>Los {primaryKeyword.toLocaleLowerCase('es')} reúnen explicaciones prácticas, datos de contexto y enlaces hacia herramientas relacionadas. Revisa la fecha de publicación y distingue los ejemplos orientativos de las cifras que dependen de tu situación.</p><p>Antes de decidir, reúne importes, plazos y condiciones comprobables. Abre las calculadoras enlazadas desde cada artículo y cambia una variable cada vez para entender qué produce la diferencia. Cuando intervenga una norma o un indicador, consulta también la fuente oficial.</p><h2>Qué debes comprobar</h2><p>Confirma costes, comisiones, impuestos y limitaciones que no estén incluidos en una simulación. El contenido ayuda a ordenar preguntas y escenarios, pero no sustituye contratos, resoluciones administrativas ni asesoramiento profesional.</p><h2>Preguntas frecuentes</h2><details><summary>¿Cómo elijo el artículo adecuado?</summary><p>Empieza por el título más cercano a la decisión que estás preparando y revisa las herramientas relacionadas.</p></details><details><summary>¿Puedo usar mis propios datos?</summary><p>Sí. Las calculadoras permiten sustituir los ejemplos por importes y plazos de tu caso.</p></details><details><summary>¿La información se actualiza?</summary><p>Comprueba las fechas publicadas y contrasta los datos variables con la fuente oficial correspondiente.</p></details></section>
  </section>
  <section class="container narrow prose"><p>Guarda los valores utilizados y la fecha de consulta. Si el artículo menciona un índice, una campaña fiscal o una condición financiera, verifica la publicación oficial más reciente antes de trasladarla a una decisión.</p><p>Explora también otras categorías para relacionar vivienda, financiación, ahorro e impuestos. Conviene revisar el coste total, el plazo y la liquidez de forma conjunta.</p><p>Si aún no encuentras un caso idéntico al tuyo, empieza por el contenido más próximo y utiliza sus preguntas como lista de comprobación. Después adapta los importes en la calculadora correspondiente y documenta cualquier supuesto que no puedas confirmar.</p></section>
</Layout>
