---
import Layout from '../../layouts/Layout.astro';
import SeoLandingPage from '../../components/SeoLandingPage.astro';
import { calculateHourlyWage } from '../../lib/calculations/hourly-wage.ts';
import { formatEuro, formatNumber } from '../../lib/formatters/currency.ts';
const result = calculateHourlyWage({ annualGrossSalary: 30000, weeklyHours: 40, vacationWeeks: 4, extraAnnualHours: 0 });
---
<Layout title="Salario de 30.000 euros con 40 horas semanales | Cifria" description="Convierte un salario bruto anual de 30.000 euros en una referencia de salario bruto por hora con 40 horas semanales.">
  <SeoLandingPage
    interpretation={{
      title: "Repartir 30.000 euros sin cambiar la remuneración anual",
      paragraphs: [
        "Un salario de 30.000 euros con 40 horas semanales equivale a unos 14,42 euros brutos por hora si usas 52 semanas, pues divides 30.000 entre 2.080 horas. Con 48 semanas, la referencia sería de 15,63 euros redondeados. La diferencia procede del calendario usado, no de una subida salarial; anota las semanas junto al resultado para poder interpretarlo.",
        "Distribuir esos 30.000 euros entre doce pagas da 2.500 euros brutos por paga; entre catorce, unos 2.142,86 euros si todas son iguales. El total anual y la referencia horaria siguen siendo los mismos. Si una oferta añade un bonus variable a los 30.000 euros, calcula primero el fijo y después una segunda hipótesis con el bonus, en lugar de dar por garantizado ese ingreso.",
      ],
    }}
    title="Salario de 30.000 € con 40 horas semanales" description="Calcula una referencia del salario bruto por hora a partir de 30.000 € anuales y una jornada de 40 horas." intro={`Con 30.000 € brutos al año, 40 horas semanales y 4 semanas de vacaciones como supuesto, el modelo estima ${formatEuro(result.hourlyGross)} brutos por hora y ${formatNumber(result.annualHours)} horas anuales.`} exampleTitle="Supuesto del ejemplo" exampleText={`30.000 € brutos/año · 40 h/semana · 4 semanas de vacaciones · ${formatNumber(result.workingWeeks)} semanas de trabajo · ${formatNumber(result.annualHours)} horas/año.`} calculatorHref="/nomina/salario-por-hora/" calculatorLabel="Calcular salario por hora" sections={[
    { title: 'El salario por hora depende de las horas reales', paragraphs: ['No basta con dividir el salario anual entre 2.080 si tu jornada efectiva o tus vacaciones son distintas. La herramienta permite ajustar las semanas de vacaciones y las horas adicionales.', 'El resultado es bruto: no aplica IRPF ni cotizaciones para convertirlo en salario neto.'] },
    { title: 'Cambiar la jornada cambia la referencia', paragraphs: ['Si mantienes el salario anual y reduces las horas trabajadas, el valor bruto por hora aumenta.', 'Por eso esta cifra puede servir para comparar puestos con diferentes jornadas, siempre que uses supuestos coherentes.'] },
    { title: 'No es un cálculo de nómina neta', paragraphs: ['La herramienta no pretende reproducir una nómina concreta. Para calcular un neto habría que incorporar parámetros fiscales y de Seguridad Social.', 'Aquí nos centramos en una división del salario bruto anual entre las horas estimadas del año.'] },
  ]} faqs={[
    { question: '¿Cuánto se cobra por hora con 30.000 € y 40 horas semanales?', answer: `Con los supuestos del ejemplo, la referencia es de ${formatEuro(result.hourlyGross)} brutos por hora.` },
    { question: '¿Por qué se descuentan las vacaciones?', answer: 'Porque la calculadora intenta estimar las horas efectivamente trabajadas en el año, en lugar de usar automáticamente 52 semanas completas.' },
    { question: '¿Es salario neto?', answer: 'No. Es una referencia de salario bruto por hora y no incorpora retenciones ni cotizaciones.' },
  ]} />
</Layout>
