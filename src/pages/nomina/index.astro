---
import Layout from '../../layouts/Layout.astro';
import Card from '../../components/Card.astro';
---
<Layout title="Calculadoras de nómina | Calculadoras ES" description="Calculadoras de sueldo neto, bruto, retenciones y pagas en España.">
  <div class="container category-page">
    <section class="category-hero"><span class="kicker">Nómina</span><h1>Entiende cuánto cobras realmente.</h1><p>Herramientas para pasar de bruto a neto y comparar distintos escenarios salariales.</p></section>
    <div class="card-grid">
      <Card title="Sueldo bruto a neto" description="Estimación del neto anual y mensual a partir del salario bruto." href="#" eyebrow="Próximamente" />
      <Card title="12 vs 14 pagas" description="Compara cómo cambia tu nómina mensual y anual." href="#" eyebrow="Próximamente" />
      <Card title="Retención IRPF" description="Estimación orientativa de retención según tus datos." href="#" eyebrow="Próximamente" />
    </div>
  </div>
</Layout>
