---
import CategoryPage from '../../components/CategoryPage.astro';
import Layout from '../../layouts/Layout.astro';
import { categories } from '../../data/categories';
const category = categories.find(({ slug }) => slug === 'nomina')!;
---
<Layout title="Calculadoras de nómina y salario | Cifria" description="Convierte tu salario bruto anual en una referencia por hora. Consulta ejemplos con jornadas de 35 y 40 horas y compara remuneración y tiempo de trabajo."><CategoryPage category={category} /></Layout>
