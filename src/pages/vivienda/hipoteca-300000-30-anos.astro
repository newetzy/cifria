---
import Layout from '../../layouts/Layout.astro';
import SeoLandingPage from '../../components/SeoLandingPage.astro';
import { calculateMortgage } from '../../lib/calculations/mortgage.ts';
import { formatEuro } from '../../lib/formatters/currency.ts';
const result = calculateMortgage({ propertyPrice: 300000, downPayment: 0, annualInterestRate: 3, years: 30 });
---
<Layout title="Hipoteca de 300.000 euros a 30 años | Cifria" description="Simula 300.000 euros de hipoteca a treinta años con un 3 % hipotético. Revisa cuota, intereses y el efecto de aportar más dinero de entrada.">
  <SeoLandingPage
    interpretation={{
      title: "Qué ocurre si aportas 30.000 euros más de entrada",
      paragraphs: [
        "Con una hipoteca de 300.000 euros a 30 años, aportar 30.000 euros adicionales reduce el principal un 10 %. Si mantienes el mismo tipo y los mismos 360 pagos, la cuota matemática y los intereses totales del modelo también bajan un 10 %. Esa proporcionalidad permite comprobar si has cambiado correctamente la entrada sin alterar accidentalmente otras variables.",
        "El ahorro de intereses no equivale a disponer hoy de esa misma cantidad: se reparte durante la vida del préstamo. Antes de dedicar los 30.000 euros a la entrada, calcula el saldo que quedaría en tu cuenta tras los gastos de compra. Compara el beneficio de una mensualidad menor con la capacidad de afrontar una reparación o una interrupción temporal de ingresos sin recurrir a otra deuda.",
      ],
    }}
    title="Hipoteca de 300.000 € a 30 años" description="Consulta una simulación de cuota e intereses para financiar 300.000 € a 30 años." intro={`Con 300.000 € financiados, 30 años y un tipo hipotético del 3 %, la cuota matemática estimada es de ${formatEuro(result.monthlyPayment)} al mes. Es un ejemplo para comparar escenarios, no una oferta real.`} exampleTitle="Simulación orientativa" exampleText={`Cuota estimada: ${formatEuro(result.monthlyPayment)} · intereses estimados: ${formatEuro(result.totalInterest)} · total de cuotas: ${formatEuro(result.totalPaid)}.`} calculatorHref="/vivienda/calculadora-hipoteca/" calculatorLabel="Calcular mi hipoteca" sections={[
    { title: 'Qué significa financiar 300.000 €', paragraphs: ['El capital financiado determina la base sobre la que se calcula la cuota. Manteniendo el mismo tipo y plazo, financiar más capital implica una cuota y un coste total mayores.', 'La entrada inicial cambia el importe realmente financiado, por lo que conviene distinguir siempre entre precio de la vivienda y capital del préstamo.'] },
    { title: '30 años frente a otros plazos', paragraphs: ['Puedes repetir el cálculo a 20, 25 y 30 años para ver cómo cambia la mensualidad.', 'Comparar el total de intereses ayuda a valorar el coste de elegir una cuota mensual más baja.'] },
    { title: 'Usa tus condiciones reales', paragraphs: ['Sustituye el tipo hipotético del ejemplo por el que quieras estudiar. La calculadora trabaja con amortización francesa y pagos mensuales.', 'No se incluyen automáticamente impuestos, seguros, comisiones ni otros gastos de una operación inmobiliaria.'] },
  ]} faqs={[
    { question: '¿Cuál sería la cuota de 300.000 € a 30 años?', answer: `Con un 3 % hipotético y sin entrada, la cuota matemática aproximada es de ${formatEuro(result.monthlyPayment)} al mes.` },
    { question: '¿Cuánto se pagaría de intereses?', answer: `En el ejemplo, los intereses acumulados ascienden aproximadamente a ${formatEuro(result.totalInterest)}.` },
    { question: '¿Puedo cambiar el tipo de interés?', answer: 'Sí. La calculadora permite modificar capital, entrada, tipo y plazo para construir tu propio escenario.' },
  ]} />
</Layout>
