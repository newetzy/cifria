---
import CategoryPage from '../../components/CategoryPage.astro';
import Layout from '../../layouts/Layout.astro';
import { categories } from '../../data/categories';
const category = categories.find(({ slug }) => slug === 'vivienda')!;
---
<Layout title="Calculadoras de vivienda e hipoteca | Cifria" description="Calculadoras para estimar cuotas de hipoteca, financiación y otros costes relacionados con la vivienda."><CategoryPage category={category} /></Layout>
