---
import CategoryPage from '../../components/CategoryPage.astro';
import Layout from '../../layouts/Layout.astro';
import { categories } from '../../data/categories';
const category = categories.find(({ slug }) => slug === 'vivienda')!;
---
<Layout title="Calculadoras para comprar vivienda | Cifria" description="Simula tu hipoteca y estudia la rentabilidad de un alquiler. Distingue precio, entrada, financiación y gastos con calculadoras y escenarios de vivienda."><CategoryPage category={category} /></Layout>
