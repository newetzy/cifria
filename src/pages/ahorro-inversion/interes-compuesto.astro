---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Calculadora de interés compuesto | Calculadoras ES" description="Calcula el crecimiento de una inversión con capital inicial, aportaciones, rentabilidad y plazo.">
  <div class="container calculator-wrap">
    <div class="calc-header">
      <span class="kicker">Ahorro e inversión</span>
      <h1>Calculadora de interés compuesto</h1>
      <p>Introduce una cantidad inicial, aportaciones periódicas, una rentabilidad estimada y un plazo. El resultado se calcula directamente en tu navegador.</p>
    </div>

    <div class="calc-shell">
      <section class="calc-card">
        <div class="input-row">
          <div class="field"><label for="initial">Capital inicial (€)</label><input id="initial" type="number" min="0" step="100" value="10000" /></div>
          <div class="field"><label for="contribution">Aportación mensual (€)</label><input id="contribution" type="number" min="0" step="10" value="300" /></div>
        </div>
        <div class="input-row">
          <div class="field"><label for="return">Rentabilidad anual (%)</label><input id="return" type="number" step="0.1" value="7" /></div>
          <div class="field"><label for="years">Plazo (años)</label><input id="years" type="number" min="1" max="100" step="1" value="20" /></div>
        </div>
        <button class="calc-button" id="calculate" type="button">Calcular resultado</button>
        <div class="note">La rentabilidad introducida es una hipótesis. No representa una rentabilidad garantizada ni tiene en cuenta impuestos, comisiones o inflación.</div>
      </section>

      <section class="result-card" aria-live="polite">
        <div class="result-label">Capital estimado al final del periodo</div>
        <div class="result-main" id="finalValue">—</div>
        <div class="stats">
          <div class="stat"><span class="result-label">Dinero aportado</span><strong id="contributed">—</strong></div>
          <div class="stat"><span class="result-label">Intereses generados</span><strong id="interest">—</strong></div>
        </div>
        <div class="bar" aria-label="Proporción entre aportaciones e intereses"><span class="bar-principal" id="barPrincipal"></span><span class="bar-interest" id="barInterest"></span></div>
      </section>
    </div>
  </div>

  <script>
    const euro = new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR', maximumFractionDigits: 2 });
    const initialEl = document.querySelector('#initial');
    const contributionEl = document.querySelector('#contribution');
    const returnEl = document.querySelector('#return');
    const yearsEl = document.querySelector('#years');
    const finalEl = document.querySelector('#finalValue');
    const contributedEl = document.querySelector('#contributed');
    const interestEl = document.querySelector('#interest');
    const principalBar = document.querySelector('#barPrincipal');
    const interestBar = document.querySelector('#barInterest');
    const calculateButton = document.querySelector('#calculate');

    function calculate() {
      const initial = Math.max(0, Number(initialEl.value) || 0);
      const monthly = Math.max(0, Number(contributionEl.value) || 0);
      const annual = Number(returnEl.value) || 0;
      const years = Math.max(1, Math.min(100, Number(yearsEl.value) || 1));
      const months = years * 12;
      const monthlyRate = annual / 100 / 12;

      let balance = initial;
      for (let month = 0; month < months; month += 1) {
        balance *= 1 + monthlyRate;
        balance += monthly;
      }

      const contributed = initial + monthly * months;
      const interest = Math.max(0, balance - contributed);
      const total = Math.max(0.01, balance);
      const principalPct = Math.min(100, Math.max(0, contributed / total * 100));
      const interestPct = 100 - principalPct;

      finalEl.textContent = euro.format(balance);
      contributedEl.textContent = euro.format(contributed);
      interestEl.textContent = euro.format(interest);
      principalBar.style.gridTemplateColumns = `${principalPct}% ${interestPct}%`;
    }

    calculateButton.addEventListener('click', calculate);
    for (const el of [initialEl, contributionEl, returnEl, yearsEl]) el.addEventListener('input', calculate);
    calculate();
  </script>
</Layout>
