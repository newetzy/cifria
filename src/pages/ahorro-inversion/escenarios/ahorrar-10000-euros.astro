---
import Layout from "../../../layouts/Layout.astro";
import SeoLandingPage from "../../../components/SeoLandingPage.astro";
---
<Layout title='Cómo ahorrar 10.000 euros | Cifria' description='Estima qué aportación mensual necesitas para alcanzar un objetivo de ahorro de 10.000 €.'>
  <SeoLandingPage title='Cómo ahorrar 10.000 €' description='Estima qué aportación mensual necesitas para alcanzar un objetivo de ahorro de 10.000 €.' intro='Una meta de 10.000 € se puede dividir en aportaciones periódicas y un plazo concreto para hacerla medible.' exampleTitle="Ejemplo de uso" exampleText='Prueba primero sin rentabilidad para saber qué esfuerzo de ahorro exige la meta. Después puedes comparar un escenario con rentabilidad hipotética.' calculatorHref='/ahorro-inversion/objetivo-ahorro/' calculatorLabel='Calcular objetivo' sections={[{ title: 'Dividir una meta', paragraphs: ['Cuanto más largo sea el plazo, menor puede ser la aportación mensual necesaria para alcanzar la misma cifra, manteniendo el resto de supuestos.'] },
    { title: 'No dependas de una rentabilidad', paragraphs: ['Para una meta con fecha concreta es más prudente entender primero el esfuerzo de aportación sin asumir crecimiento.'] }]} faqs={[{ question: '¿Puedo cambiar la meta?', answer: 'Sí. La calculadora permite adaptar objetivo, plazo y rentabilidad hipotética.' },
    { question: '¿El cálculo garantiza llegar a 10.000 €?', answer: 'Solo muestra el resultado bajo los supuestos introducidos. El ahorro real depende de que mantengas las aportaciones.' }]} />
</Layout>
