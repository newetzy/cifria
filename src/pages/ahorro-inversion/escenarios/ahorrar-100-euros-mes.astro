---
import Layout from "../../../layouts/Layout.astro";
import SeoLandingPage from "../../../components/SeoLandingPage.astro";
---
<Layout title='Ahorrar 100 euros al mes | Cifria' description='Calcula cuánto acumulas ahorrando 100 € al mes y separa aportaciones de rentabilidad.'>
  <SeoLandingPage title='Ahorrar 100 euros al mes' description='Calcula cuánto acumulas ahorrando 100 € al mes y separa aportaciones de rentabilidad.' intro='Ahorrar 100 euros al mes suma 1.200 euros al año antes de cualquier rentabilidad y permite convertir una meta grande en un hábito asumible.' exampleTitle="Ejemplo de uso" exampleText='Compara el resultado sin rentabilidad con uno o varios escenarios hipotéticos. Así puedes distinguir ahorro realizado de crecimiento de la inversión.' calculatorHref='/ahorro-inversion/aportaciones-periodicas/' calculatorLabel='Simular aportaciones' sections={[{ title: 'Constancia', paragraphs: ['Las aportaciones periódicas permiten medir el esfuerzo de ahorro de forma sencilla.', 'Programa la transferencia justo después de cobrar y revisa el importe cuando cambien tus ingresos o gastos. La regularidad suele importar más que perseguir una cifra elevada que no puedas mantener.'] },
    { title: 'Rentabilidad', paragraphs: ['Una rentabilidad hipotética puede aumentar el capital final, pero no garantiza un rendimiento futuro.', 'Si el dinero tiene un objetivo cercano, prioriza liquidez y seguridad. Para plazos largos, compara comisiones, riesgo y fiscalidad antes de usar una hipótesis de crecimiento.'] }]} faqs={[{ question: '¿Cuánto ahorro en un año?', answer: '100 € al mes son 1.200 € al año si mantienes las doce aportaciones.' },
    { question: '¿La rentabilidad está garantizada?', answer: 'No. Los escenarios de rentabilidad son hipótesis y no una promesa de resultados.' }, { question: '¿Puedo aumentar la aportación?', answer: 'Sí. Prueba importes distintos para adaptar el plan a tu presupuesto y a la fecha de tu objetivo.' }]} />
</Layout>
