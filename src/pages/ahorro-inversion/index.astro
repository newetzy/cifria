---
import Layout from '../../layouts/Layout.astro';
import Card from '../../components/Card.astro';
---
<Layout title="Calculadoras de ahorro e inversión | Calculadoras ES" description="Calculadoras de interés compuesto, ahorro periódico, inflación y rentabilidad.">
  <div class="container category-page">
    <section class="category-hero"><span class="kicker">Ahorro e inversión</span><h1>Descubre cuánto puede crecer tu dinero.</h1><p>Herramientas para visualizar el efecto del tiempo, las aportaciones y la rentabilidad.</p></section>
    <div class="card-grid">
      <Card title="Interés compuesto" description="Calcula el crecimiento de una inversión con aportaciones y rentabilidad." href="/ahorro-inversion/interes-compuesto/" eyebrow="Disponible" />
      <Card title="Inflación" description="Estima el poder adquisitivo futuro de una cantidad de dinero." href="#" eyebrow="Próximamente" />
      <Card title="Ahorro mensual" description="Calcula cuánto acumularás con una aportación periódica." href="#" eyebrow="Próximamente" />
    </div>
  </div>
</Layout>
