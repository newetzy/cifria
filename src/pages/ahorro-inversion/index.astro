import { categories } from '../../data/categories';
const category = categories.find(({ slug }) => slug === 'ahorro-inversion')!;
---
<Layout title="Calculadoras de ahorro e inversión | Cifria" description="Calculadoras gratuitas para ahorrar, invertir y entender el efecto del tiempo, la rentabilidad y la inflación."><CategoryPage category={category} /></Layout>
