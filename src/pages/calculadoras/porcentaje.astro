---
import CalculatorShell from '../../components/CalculatorShell.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Calculadora de porcentajes | Cifria" description="Calcula rápidamente cuánto es un porcentaje de una cantidad y cuál es el total resultante.">
<section class="calculator-page-section"><CalculatorShell title="Calculadora de porcentajes" description="Calcula rápidamente cuánto es un porcentaje de una cantidad y cuál es el total resultante.">
<div class="calculator-layout"><form id="percentage-form" class="calculator-form" novalidate><fieldset><legend>Datos del cálculo</legend><div class="calculator-fields"><div class="field"><label for="percentage">Porcentaje</label><div class="input-with-suffix"><input id="percentage" type="number" min="0" step="0.01" value="15" /><span>%</span></div></div><div class="field"><label for="value">Cantidad</label><div class="input-with-suffix"><input id="value" type="number" min="0" step="0.01" value="200" /><span>€</span></div></div></div></fieldset><button type="submit">Calcular</button><p class="calculator-privacy">El cálculo se realiza en tu navegador.</p></form>
<div class="calculator-results"><p class="eyebrow">Resultado</p><section class="result-card result-card-primary"><p>Porcentaje calculado</p><strong data-result="amount">—</strong><span>Importe correspondiente al porcentaje indicado.</span></section><div class="result-grid"><section class="result-card"><p>Valor original</p><strong data-result="value">—</strong></section><section class="result-card"><p>Total con el porcentaje añadido</p><strong data-result="total">—</strong></section></div></div></div>
<section class="content-section prose"><p class="eyebrow">Cómo se calcula</p><h2>¿Cómo calcular un porcentaje?</h2>Multiplicamos la cantidad por el porcentaje expresado como fracción de 100. Es útil para incrementos, comisiones, impuestos o comparaciones rápidas.</section>
<Disclaimer>El resultado es una estimación matemática y no sustituye asesoramiento profesional.</Disclaimer>
<RelatedTools tools={[{ href: "/calculadoras/descuento/", title: "Calculadora de descuentos", description: "Calcula el precio final tras una rebaja." }, { href: "/impuestos/calculadora-iva/", title: "Calculadora de IVA", description: "Añade o quita IVA de un importe." }]} />
</CalculatorShell></section>
</Layout>
<script>import percentage from '../../scripts/percentage';</script>
