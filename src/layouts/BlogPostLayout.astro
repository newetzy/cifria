---
import type { CollectionEntry } from 'astro:content';
import Layout from './Layout.astro';
import RelatedTools from '../components/RelatedTools.astro';
import type { Tool } from '../data/tools';

interface Props {
  post: CollectionEntry<'blog'>;
  relatedTools: Tool[];
}

const { post, relatedTools } = Astro.props;
const words = (post.body ?? '').split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.ceil(words / 200));
const publishedDate = post.data.pubDate.toLocaleDateString('es-ES', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
const updatedDate = post.data.updatedDate?.toLocaleDateString('es-ES', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<Layout title={`${post.data.title} | Cifria`} description={post.data.description} image={post.data.heroImage} metaType="article">
  <article class="blog-post">
    <header class="blog-post-header container narrow">
      <p class="eyebrow">{post.data.category.replace('-', ' ')}</p>
      <h1>{post.data.title}</h1>
      <p class="lead"><strong>{post.data.title}</strong>: {post.data.description}</p>
      <p class="blog-post-meta">
        <span>Por {post.data.author}</span>
        <span><time datetime={post.data.pubDate.toISOString()}>Publicado el {publishedDate}</time></span>
        {updatedDate && <span>Actualizado el {updatedDate}</span>}
        <span>{readingMinutes} min de lectura</span>
      </p>
    </header>
    {post.data.heroImage && <img class="blog-post-hero" src={post.data.heroImage} alt="" />}
    <div class="container narrow">
      <div class="blog-post-content prose"><slot />
        <section><h2>Cómo aplicar esta información</h2><p>Contrasta las cifras y fechas del artículo con fuentes oficiales y con las condiciones de tu caso. Cuando compares alternativas, utiliza los mismos importes, plazos y supuestos para evitar conclusiones engañosas.</p><p>Las herramientas relacionadas permiten convertir la explicación en una simulación con tus datos. Sus resultados son orientativos y no sustituyen una oferta, una liquidación administrativa ni asesoramiento profesional.</p></section>
        <section class="faq-section"><h2>Preguntas frecuentes sobre {post.data.title}</h2><details><summary>¿Puedo usar mis propios datos?</summary><p>Sí. Abre las calculadoras relacionadas y sustituye los ejemplos por cifras comprobables de tu situación.</p></details><details><summary>¿El artículo ofrece un resultado definitivo?</summary><p>No. Explica criterios generales que debes contrastar con normativa, contratos y datos actualizados.</p></details><details><summary>¿Dónde continúo la comparación?</summary><p>Al final del artículo encontrarás herramientas relacionadas para calcular escenarios y revisar cómo cambia el resultado.</p></details></section>
      </div>
      {relatedTools.length > 0 && <RelatedTools tools={relatedTools} />}
    </div>
  </article>
</Layout>
