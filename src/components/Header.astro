---
import { navigation } from '../data/categories';
const pathname = Astro.url.pathname;
---
<header class="site-header"><div class="container header-inner"><a class="brand" href="/" aria-label="Cifria, inicio"><span class="brand-mark" aria-hidden="true">C</span><span>Cifria</span></a><nav aria-label="Navegación principal"><ul class="main-nav">{navigation.map(({ href, name }) => <li><a href={href} aria-current={pathname === href ? 'page' : undefined}>{name}</a></li>)}<li><a href="/calculadoras/" aria-current={pathname === '/calculadoras/' ? 'page' : undefined}>Más calculadoras</a></li><li><a href="/buscar/" aria-current={pathname === '/buscar/' ? 'page' : undefined}>Buscar</a></li></ul></nav></div></header>
