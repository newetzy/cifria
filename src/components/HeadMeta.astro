---
interface Props {
  title: string;
  description: string;
  canonical: string;
  noindex?: boolean;
  image?: string;
  type?: 'website' | 'article';
}

const { title, description, canonical, noindex = false, image, type = 'website' } = Astro.props;
const callToAction = ' Descúbrelo aquí.';
const cleanTitle = title.replace(/\s*\|\s*Cifria$/, '');
const descriptionLimit = 154 - callToAction.length;
const descriptionMinimum = 144 - callToAction.length;
const descriptionWords = `${cleanTitle}: ${description}`.match(/\S+/g) ?? [];
let descriptionBody = '';
for (const word of descriptionWords) {
  const candidate = `${descriptionBody} ${word}`.trim();
  if (candidate.length > descriptionLimit) break;
  descriptionBody = candidate;
}
const danglingWords = new Set(['a', 'al', 'con', 'de', 'del', 'el', 'en', 'la', 'las', 'los', 'para', 'por', 'que', 'sin', 'su', 'sus', 'tu', 'tus', 'un', 'una', 'y']);
let bodyWords = descriptionBody.replace(/[,:;]+$/, '').split(/\s+/);
while (bodyWords.length > 1 && danglingWords.has(bodyWords.at(-1)?.toLocaleLowerCase('es') ?? '')) {
  bodyWords = bodyWords.slice(0, -1);
}
descriptionBody = bodyWords.join(' ').replace(/[,:;.!?]+$/, '');
const usefulEndings = [' Más detalles y ejemplos útiles', ' Información práctica y ejemplos claros', ' Consulta ejemplos útiles', ' Más detalles prácticos', ' Más detalles', ' Guía útil'];
for (const ending of usefulEndings) {
  if (descriptionBody.length >= descriptionMinimum) break;
  if (descriptionBody.length + 1 + ending.length <= descriptionLimit) descriptionBody += `.${ending}`;
}
const seoDescription = noindex ? description : `${descriptionBody}.${callToAction}`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={seoDescription} />
<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
<link rel="canonical" href={canonical} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<meta property="og:type" content={type} />
<meta property="og:locale" content="es_ES" />
<meta name="theme-color" content="#17342d" />
<meta property="og:site_name" content="Cifria" />
<meta property="og:title" content={title} />
<meta property="og:description" content={seoDescription} />
<meta property="og:url" content={canonical} />
{image && <meta property="og:image" content={new URL(image, canonical).toString()} />}
<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={seoDescription} />
{image && <meta name="twitter:image" content={new URL(image, canonical).toString()} />}
<title>{title}</title>
