---
import type { Category } from '../data/categories';
interface Props { category: Category; }
const { category } = Astro.props;
const primaryKeywords: Record<string, string> = {
  'ahorro-inversion': 'Calculadoras de ahorro e inversión',
  coche: 'Calculadoras de costes del coche',
  impuestos: 'Calculadoras de impuestos en España',
  nomina: 'Calculadoras de nómina y salario',
  prestamos: 'Calculadoras de préstamos personales',
  vivienda: 'Calculadoras para comprar vivienda',
};
const primaryKeyword = primaryKeywords[category.slug] ?? `Calculadoras de ${category.name.toLowerCase()}`;
const seoLinks: Record<string, { href: string; title: string; description: string }[]> = {
  vivienda: [
    { href: '/vivienda/cuota-hipoteca-20-anos/', title: 'Hipoteca a 20 años', description: 'Compara cuota e intereses con un plazo de 20 años.' },
    { href: '/vivienda/cuota-hipoteca-30-anos/', title: 'Hipoteca a 30 años', description: 'Explora el efecto de un plazo hipotecario largo.' },
    { href: '/vivienda/hipoteca-250000-30-anos/', title: 'Hipoteca de 250.000 € a 30 años', description: 'Consulta una simulación con un ejemplo concreto de capital y plazo.' },
    { href: '/vivienda/hipoteca-300000-30-anos/', title: 'Hipoteca de 300.000 € a 30 años', description: 'Consulta otra referencia de cuota e intereses con 30 años.' },
  ],
  prestamos: [
    { href: '/prestamos/cuota-prestamo-5000-euros/', title: 'Préstamo de 5.000 €', description: 'Simula cuota, plazo e intereses.' },
    { href: '/prestamos/prestamo-15000-5-anos/', title: 'Préstamo de 15.000 € a 5 años', description: 'Usa una referencia concreta para comparar cuota y coste total.' },
    { href: '/prestamos/prestamo-20000-7-anos/', title: 'Préstamo de 20.000 € a 7 años', description: 'Compara una financiación de plazo más largo.' },
  ],
  'ahorro-inversion': [
    { href: '/ahorro-inversion/ahorrar-200-euros-mes/', title: 'Ahorrar 200 € al mes', description: 'Mide cuánto puedes acumular con una aportación constante.' },
    { href: '/ahorro-inversion/ahorrar-300-euros-mes/', title: 'Ahorrar 300 € al mes', description: 'Mide cuánto acumulas con aportaciones mensuales.' },
    { href: '/ahorro-inversion/ahorrar-500-euros-mes/', title: 'Ahorrar 500 € al mes', description: 'Compara ahorro e inversión durante varios años.' },
    { href: '/ahorro-inversion/200-euros-5-porciento-10-anos/', title: '200 € al mes al 5 % durante 10 años', description: 'Consulta una simulación concreta de interés compuesto.' },
  ],
  nomina: [
    { href: '/nomina/salario-por-hora-40-horas/', title: 'Salario por hora con 40 horas', description: 'Convierte tu salario anual en valor bruto por hora.' },
    { href: '/nomina/salario-30000-40-horas/', title: 'Salario de 30.000 € con 40 horas', description: 'Consulta una referencia concreta de salario bruto por hora.' },
  ],
  coche: [
    { href: '/coche/coste-viaje-gasolina/', title: 'Coste de un viaje en gasolina', description: 'Estima el combustible necesario para un trayecto.' },
    { href: '/coche/coste-viaje-500-km/', title: 'Coste de un viaje de 500 km', description: 'Consulta una referencia concreta para un trayecto de 500 km.' },
  ],
  impuestos: [{ href: '/impuestos/calculadora-iva-21-por-ciento/', title: 'IVA del 21 %', description: 'Añade o separa IVA del precio final.' }],
};

const links: Record<string, Record<string, string>> = {
  impuestos: { 'Calculadora de IVA': '/impuestos/calculadora-iva/', 'Añadir o quitar IVA': '/impuestos/calculadora-iva/' },
  'ahorro-inversion': { 'Interés compuesto': '/ahorro-inversion/interes-compuesto/', 'ROI': '/ahorro-inversion/roi/', 'Objetivo de ahorro': '/ahorro-inversion/objetivo-ahorro/', 'Inflación': '/ahorro-inversion/calculadora-inflacion/', 'Aportaciones periódicas': '/ahorro-inversion/aportaciones-periodicas/', 'Interés simple': '/ahorro-inversion/interes-simple/' },
  vivienda: { 'Calculadora de hipoteca': '/vivienda/calculadora-hipoteca/', 'Rentabilidad del alquiler': '/vivienda/rentabilidad-alquiler/' },
  prestamos: { 'Cuota de préstamo': '/prestamos/calculadora-cuota-prestamo/', 'Amortización anticipada': '/prestamos/amortizacion-anticipada/' },
  nomina: { 'Salario por hora': '/nomina/salario-por-hora/' },
  coche: { 'Coste de viaje': '/coche/coste-viaje/', 'Coste por kilómetro': '/coche/coste-por-kilometro/' },
};
---
<section class="page-hero page-hero-compact"><div class="container narrow"><p class="eyebrow">Categoría {category.accent}</p><h1>{primaryKeyword}</h1><p class="lead"><strong>{primaryKeyword}</strong>: {category.description}</p></div></section>
<section class="section"><div class="container narrow"><div class="section-heading"><div><p class="eyebrow">Herramientas</p><h2>Calculadoras de {category.name.toLowerCase()}</h2></div><p>Calcula online y consulta después la metodología y las limitaciones de cada herramienta.</p></div><div class="tool-list">{category.tools.filter((tool) => links[category.slug]?.[tool]).map((tool) => { const href = links[category.slug]?.[tool]; return <article class="card tool-card"><h3><a href={href}>{tool}</a></h3><p class="tool-card-status">Disponible</p></article>; })}</div></div></section>
<section class="section section-tint"><div class="container narrow"><div class="section-heading"><div><p class="eyebrow">También puedes buscar</p><h2>Páginas de cálculo concretas</h2></div><p>Escenarios frecuentes con explicaciones y acceso directo a la calculadora.</p></div><div class="tool-list seo-tool-list">{(seoLinks[category.slug] ?? []).map((item) => <article class="card tool-card seo-tool-card"><h3><a href={item.href}>{item.title}</a></h3><p>{item.description}</p></article>)}</div></div></section>
<section class="section"><div class="container narrow prose">
  <h2>Cómo utilizar estas calculadoras</h2>
  <p>Las {primaryKeyword.toLocaleLowerCase('es')} reúnen herramientas y ejemplos del mismo tema para que puedas pasar de una estimación general a un caso concreto sin mezclar criterios.</p>
  <p>Empieza por la herramienta que responda a tu decisión inmediata y reúne antes los datos que puedas comprobar. Introducir importes reales, plazos comparables y gastos completos ayuda a que el resultado sea más útil. Si todavía no conoces una cifra, prueba un escenario prudente y otro más exigente para observar cuánto cambia la estimación.</p>
  <p>Compara siempre resultados obtenidos con los mismos supuestos. Una cuota menor, un porcentaje mayor o una cifra final más alta no bastan por sí solos para elegir: también importan el plazo, la liquidez, el riesgo y los costes que la herramienta indique como no incluidos.</p>
  <h2>Qué significa el resultado</h2>
  <p>Las calculadoras de {category.name.toLowerCase()} ofrecen simulaciones matemáticas y explican las variables empleadas. No representan una oferta comercial, una resolución administrativa ni asesoramiento personalizado. Guarda los datos utilizados y confirma las condiciones reales con el contrato, la entidad o el organismo correspondiente antes de tomar una decisión.</p>
  <p>Puedes continuar con los ejemplos de esta categoría para entender casos concretos y después abrir la calculadora principal para sustituirlos por tus cifras. Esta navegación conecta conceptos, escenarios y herramientas sin obligarte a empezar cada comparación desde cero.</p>
  <section class="faq-section">
    <h2>Preguntas frecuentes</h2>
    <details><summary>¿Los resultados son definitivos?</summary><p>No. Son estimaciones basadas en los datos introducidos y en los supuestos explicados por cada herramienta.</p></details>
    <details><summary>¿Puedo comparar varios escenarios?</summary><p>Sí. Mantén iguales las variables que no quieras estudiar y modifica una condición cada vez para interpretar mejor la diferencia.</p></details>
    <details><summary>¿Qué datos debo comprobar?</summary><p>Revisa importes, plazos, tipos, comisiones, impuestos y cualquier gasto que pueda influir en el resultado real.</p></details>
  </section>
</div></section>
