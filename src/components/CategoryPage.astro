---
import type { Category } from '../data/categories';
import { categoryEditorial } from '../data/category-editorial';
import { tools } from '../data/tools';
interface Props { category: Category; }
const { category } = Astro.props;
const editorial = categoryEditorial[category.slug];
const primaryKeywords: Record<string, string> = {
  'ahorro-inversion': 'Calculadoras de ahorro e inversión',
  coche: 'Calculadoras de costes del coche',
  impuestos: 'Calculadoras de impuestos en España',
  nomina: 'Calculadoras de nómina y salario',
  prestamos: 'Calculadoras de préstamos personales',
  vivienda: 'Calculadoras para comprar vivienda',
};
const primaryKeyword = primaryKeywords[category.slug] ?? `Calculadoras de ${category.name.toLowerCase()}`;
const categoryTools = tools.filter((tool) => tool.category === category.name);
const calculators = categoryTools.filter((tool) => tool.type === 'calculadora');
const scenarios = categoryTools.filter((tool) => tool.type === 'escenario');
const comparisons = categoryTools.filter((tool) => tool.type === 'comparador');
---
<section class="page-hero page-hero-compact"><div class="container narrow"><p class="eyebrow">Categoría {category.accent}</p><h1>{primaryKeyword}</h1><p class="lead"><strong>{primaryKeyword}</strong>: {category.description}</p></div></section>
<section class="section"><div class="container narrow">
  <div class="section-heading"><div><p class="eyebrow">Herramientas</p><h2>Calculadoras de {category.name.toLowerCase()}</h2></div><p>Calcula online y consulta después la metodología y las limitaciones de cada herramienta.</p></div>
  <div class="tool-list">{calculators.map((tool) => <article class="card tool-card">
    <h3><a href={tool.href}>{tool.title}</a></h3><p>{tool.description}</p>
  </article>)}</div>
</div></section>
{scenarios.length > 0 && <section class="section section-tint"><div class="container narrow">
  <div class="section-heading"><div><p class="eyebrow">También puedes buscar</p><h2>Páginas de cálculo concretas</h2></div><p>Escenarios frecuentes con explicaciones y acceso directo a la calculadora.</p></div>
  <div class="tool-list seo-tool-list">{scenarios.map((tool) => <article class="card tool-card seo-tool-card">
    <h3><a href={tool.href}>{tool.title}</a></h3><p>{tool.description}</p>
  </article>)}</div>
</div></section>}
{comparisons.length > 0 && <section class="section"><div class="container narrow">
  <div class="section-heading"><div><p class="eyebrow">Compara alternativas</p><h2>Comparadores de {category.name.toLowerCase()}</h2></div></div>
  <div class="tool-list">{comparisons.map((tool) => <article class="card tool-card">
    <h3><a href={tool.href}>{tool.title}</a></h3><p>{tool.description}</p>
  </article>)}</div>
</div></section>}
<section class="section"><div class="container narrow prose">
  {editorial.sections.map((section) => <section>
    <h2>{section.title}</h2>
    {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  </section>)}
  <section class="faq-section">
    <h2>Preguntas frecuentes</h2>
    {editorial.faqs.map((faq) => <details><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}
  </section>
</div></section>
