---
<div class="cookie-consent" data-cookie-consent hidden role="dialog" aria-label="Preferencias de privacidad">
  <div class="cookie-consent-inner">
    <div class="cookie-consent-copy">
      <p class="cookie-consent-title">Tu privacidad importa</p>
      <p>Utilizamos analítica opcional para saber qué herramientas funcionan mejor y mejorar Cifria. La analítica solo se activa después de tu consentimiento.</p>
      <a href="/cookies/">Leer la política de cookies</a>
    </div>
    <div class="cookie-consent-actions" aria-label="Preferencias de cookies">
      <button type="button" class="cookie-button cookie-button-secondary" data-cookie-reject>Rechazar</button>
      <button type="button" class="cookie-button cookie-button-primary" data-cookie-accept>Aceptar analítica</button>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    const cifriaConsentStorageKey = 'cifria_analytics_consent';
    const cifriaConsentBanner = document.querySelector('[data-cookie-consent]');
    const cifriaAcceptButton = document.querySelector('[data-cookie-accept]');
    const cifriaRejectButton = document.querySelector('[data-cookie-reject]');

    const cifriaEnsureDataLayer = () => {
      window.dataLayer = window.dataLayer || [];
      return window.dataLayer;
    };

    const cifriaConsentUpdate = (values) => {
      cifriaEnsureDataLayer().push(['consent', 'update', values]);
    };

    const cifriaSetConsent = (value) => {
      try {
        localStorage.setItem(cifriaConsentStorageKey, value);
      } catch (_) {
        // Ignore storage errors; the consent signal can still be sent for this page view.
      }

      if (value === 'granted') {
        cifriaConsentUpdate({
          analytics_storage: 'granted',
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied'
        });
        cifriaEnsureDataLayer().push({ event: 'cifria_consent_granted' });
      } else {
        cifriaConsentUpdate({
          analytics_storage: 'denied',
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied'
        });
      }

      if (cifriaConsentBanner) cifriaConsentBanner.hidden = true;
    };

    const cifriaShowBanner = () => {
      if (cifriaConsentBanner) cifriaConsentBanner.hidden = false;
    };

    let cifriaSavedConsent = null;
    try {
      cifriaSavedConsent = localStorage.getItem(cifriaConsentStorageKey);
    } catch (_) {
      cifriaSavedConsent = null;
    }

    if (!cifriaSavedConsent) cifriaShowBanner();

    cifriaAcceptButton?.addEventListener('click', () => cifriaSetConsent('granted'));
    cifriaRejectButton?.addEventListener('click', () => cifriaSetConsent('denied'));

    document.querySelectorAll('[data-cookie-settings]').forEach((link) => {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        cifriaShowBanner();
      });
    });
  })();
</script>
