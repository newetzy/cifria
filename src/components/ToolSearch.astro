---
---
<div class="tool-search">
  <label for="tool-search-input">Buscar una herramienta</label>
  <input id="tool-search-input" type="search" placeholder="Ej.: hipoteca, salario, IVA, ahorro..." autocomplete="off" />
  <div class="tool-search-filters" aria-label="Filtrar resultados">
    <label>Tipo<select id="tool-search-type"><option value="">Todos</option><option value="calculadora">Calculadoras</option><option value="guia">Guías</option><option value="comparador">Comparadores</option><option value="escenario">Escenarios</option><option value="glosario">Glosario</option></select></label>
    <label>Categoría<select id="tool-search-category"><option value="">Todas</option></select></label>
  </div>
  <p class="tool-search-meta" id="tool-search-meta">Escribe o usa los filtros para encontrar una herramienta.</p>
  <div class="tool-search-results" id="tool-search-results" aria-live="polite"></div>
</div>
<script>
  import { tools } from '../data/tools';

  const root = document.querySelector<HTMLElement>('.tool-search');
  if (root) {
    const input = root.querySelector<HTMLInputElement>('#tool-search-input');
    const typeSelect = root.querySelector<HTMLSelectElement>('#tool-search-type');
    const categorySelect = root.querySelector<HTMLSelectElement>('#tool-search-category');
    const results = root.querySelector<HTMLElement>('#tool-search-results');
    const meta = root.querySelector<HTMLElement>('#tool-search-meta');
    if (!input || !typeSelect || !categorySelect || !results || !meta) throw new Error('Faltan elementos de la búsqueda.');
    type Tool = (typeof tools)[number];
    const typeLabels = { calculadora: 'Calculadora', guia: 'Guía', comparador: 'Comparador', escenario: 'Escenario', glosario: 'Glosario' };
    const normalize = (value: string) => value.toLocaleLowerCase('es').normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    const categories = [...new Set(tools.map((tool) => tool.category))].sort((a, b) => a.localeCompare(b, 'es'));
    categories.forEach((category) => {
      const option = document.createElement('option');
      option.value = category;
      option.textContent = category;
      categorySelect.appendChild(option);
    });
    const params = new URLSearchParams(window.location.search);
    input.value = params.get('q') ?? '';
    typeSelect.value = params.get('tipo') ?? '';
    categorySelect.value = params.get('categoria') ?? '';
    const render = (items: readonly Tool[]) => {
      results.innerHTML = items.length
        ? items.map((tool) => `<a class="search-result" href="${tool.href}"><span class="search-result-type">${typeLabels[tool.type] ?? tool.type}</span><strong>${tool.title}</strong><span>${tool.description}</span></a>`).join('')
        : '<p class="search-empty">No hemos encontrado una herramienta con esos criterios. Prueba otra búsqueda.</p>';
    };
    const update = () => {
      const query = normalize(input.value.trim());
      const type = typeSelect.value;
      const category = categorySelect.value;
      const tokens = query ? query.split(/\s+/).filter(Boolean) : [];
      const matches = tools.filter((tool) => {
        const haystack = normalize([tool.title, tool.description, tool.category, ...tool.keywords].join(' '));
        return tokens.every((token) => haystack.includes(token)) && (!type || tool.type === type) && (!category || tool.category === category);
      });
      if (!query && !type && !category) {
        meta.textContent = `Mostrando ${Math.min(12, tools.length)} de ${tools.length} herramientas.`;
        render(tools.slice(0, 12));
      } else {
        meta.textContent = `${matches.length} resultado${matches.length === 1 ? '' : 's'}${query ? ` para “${input.value.trim()}”` : ''}.`;
        render(matches);
      }
      const next = new URLSearchParams();
      if (query) next.set('q', input.value.trim());
      if (type) next.set('tipo', type);
      if (category) next.set('categoria', category);
      const target = next.toString() ? `${window.location.pathname}?${next}` : window.location.pathname;
      window.history.replaceState({}, '', target);
    };
    input.addEventListener('input', update);
    typeSelect.addEventListener('change', update);
    categorySelect.addEventListener('change', update);
    update();
  }
</script>
