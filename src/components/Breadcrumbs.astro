---
import { tools } from '../data/tools';
import { getBreadcrumbPaths } from '../lib/breadcrumbs';
const { pathname } = Astro.url;
const labels: Record<string, string> = {
  vivienda: 'Vivienda',
  nomina: 'Nómina',
  impuestos: 'Impuestos',
  prestamos: 'Préstamos',
  'ahorro-inversion': 'Ahorro e inversión',
  coche: 'Coche',
  calculadoras: 'Calculadoras',
  guias: 'Guías',
  comparadores: 'Comparadores',
  escenarios: 'Escenarios',
  glosario: 'Glosario',
  herramientas: 'Herramientas',
};
const pretty = (segment: string) => segment.replace(/-/g, ' ').replace(/\b\w/g, (m) => m.toUpperCase());
const items = getBreadcrumbPaths(pathname).map((href) => {
  const segment = href.split('/').filter(Boolean).at(-1) ?? '';
  const exactTool = tools.find((tool) => tool.href === href);
  return { href, label: exactTool?.title ?? labels[segment] ?? pretty(segment) };
});
---
{items.length > 0 && (
  <nav class="breadcrumbs container" aria-label="Migas de pan">
    <a href="/">Inicio</a>
    {items.map((item, index) => (
      <>
        <span aria-hidden="true">/</span>
        {index === items.length - 1 ? <span aria-current="page">{item.label}</span> : <a href={item.href}>{item.label}</a>}
      </>
    ))}
  </nav>
)}
{items.length > 0 && <script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://cifria.es/' },
    ...items.map((item, index) => ({ '@type': 'ListItem', position: index + 2, name: item.label, item: `https://cifria.es${item.href}` }))
  ]
})} />}
